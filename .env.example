# Sao chép file này thành .env để chạy local. Không commit khóa thật.
# Lưu ý: biến VITE_* được đóng vào bundle frontend khi build và không phải secret trên website public.
VITE_SPEAKING_PROVIDER=openrouter
VITE_SPEAKING_API_KEY=
VITE_SPEAKING_BASE_URL=https://openrouter.ai/api/v1
VITE_SPEAKING_MODEL=openrouter/free
VITE_SPEAKING_AUTO_LISTEN=true

# Preset khác:
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai | gemini-3.8-flash
# Groq:   https://api.groq.com/openai/v1 | openai/gpt-oss-20b
# xKiro:  https://api.xkiro.com/v1 | chọn model access_tier=free trong ứng dụng
